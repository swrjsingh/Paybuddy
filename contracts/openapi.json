{
  "openapi": "3.0.3",
  "info": {
    "title": "PayBuddy implemented APIs",
    "version": "0.1.0",
    "description": "Internal endpoints exist on service containers only and are not routed by the gateway. Operations endpoints require OPERATIONS role. Webhook HMAC covers timestamp + dot + raw body."
