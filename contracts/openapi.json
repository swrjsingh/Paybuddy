    "/auth/login": {
      "post": {
        "summary": "Sign in to the local sandbox",
        "tags": [
          "Gateway/Identity"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful result; see implementation and examples in README"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing/invalid credentials"
          },
          "403": {
            "description": "Wrong role or internal boundary"
          },
          "404": {
            "description": "Record not found in authorized scope"
          },
          "409": {
            "description": "Idempotency/state/content conflict"
          },
          "503": {
            "description": "Required service temporarily unavailable"
          }
        }
      }
    },
